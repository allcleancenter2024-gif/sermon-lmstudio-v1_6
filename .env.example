# Copy to a local, untracked .env only when running the application in Docker.
# Never place real passwords or Secret Keys in this file.

# MinIO / S3-compatible object storage (Docker network)
MINIO_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace_with_test_service_account
MINIO_SECRET_KEY=replace_with_test_secret
MINIO_BUCKET=sermon-documents-test
MINIO_TEST_PREFIX=_verification/
MINIO_PROD_PREFIX=production/
MINIO_REGION=us-east-1
MINIO_SECURE=false

# PostgreSQL test database (Docker network)
POSTGRES_HOST=sermon-postgres
POSTGRES_PORT=5432
POSTGRES_DB=sermon_db_test
POSTGRES_USER=sermon_user
POSTGRES_PASSWORD=replace_with_test_password
DATABASE_URL=postgresql://sermon_user:replace_with_test_password@sermon-postgres:5432/sermon_db_test

# For Windows-host execution, use these endpoint overrides instead:
# MINIO_ENDPOINT=http://127.0.0.1:9000
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5436
