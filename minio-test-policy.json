{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::sermon-documents-test"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["_verification/", "_verification/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::sermon-documents-test"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::sermon-documents-test/_verification/*"]
    }
  ]
}
