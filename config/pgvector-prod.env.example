# Copy this file to config/pgvector-prod.env. The target file is ignored by Git.
# Use a unique, high-entropy password. Do not place a real password in this example.
POSTGRES_RAG_PROD_DB=sermon_rag_prod
POSTGRES_RAG_PROD_USER=sermon_rag_app
POSTGRES_RAG_PROD_PASSWORD=replace_with_a_unique_secret
POSTGRES_RAG_PROD_PORT=15434

# Keep application traffic on SQLite until migration, readiness, and canary all pass.
RAG_BACKEND=sqlite
RAG_BACKEND_ENABLED=true
RAG_PGVECTOR_CAPABILITY_VERIFIED=false
RAG_PGVECTOR_FALLBACK_TO_SQLITE=true
# RAG_PGVECTOR_DATABASE_URL=postgresql://sermon_rag_app:<SECRET>@127.0.0.1:15434/sermon_rag_prod
