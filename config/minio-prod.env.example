# Copy to an untracked secret file before starting the production candidate.
# Never use the root credential as the application's long-lived credential.
MINIO_ROOT_USER=replace_with_minio_root_user
MINIO_ROOT_PASSWORD=replace_with_a_unique_root_secret
MINIO_APP_ACCESS_KEY=replace_with_minio_app_access_key
MINIO_APP_SECRET_KEY=replace_with_a_unique_app_secret
MINIO_BUCKET=sermon-documents
MINIO_PROD_PREFIX=production/
MINIO_PROD_PORT=19002

# Application runtime settings (keep disabled until Phase 9 gates pass).
MINIO_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:19002
MINIO_ACCESS_KEY=replace_with_minio_app_access_key
MINIO_SECRET_KEY=replace_with_a_unique_app_secret
